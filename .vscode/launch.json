{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) 응급실 시스템 디버깅",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\emergency_queue.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\MinGW\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}